<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_whatsapp" model="ir.ui.view">
        <field name="name">res.company.form.whatsapp</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">

            <xpath expr="//notebook" position="inside">
                <page string="WhatsApp">
                    <group col="2">
                        <field name="whatsapp_api_key" password="True"/>
                        <field name="whatsapp_instance" password="True"/>
                        <field name="whatsapp_server" placeholder="https://www.urlsegura.com"/>
                        <field name="whatsapp_phone_number" placeholder="Número de Whatsapp para el agente de cobranzas"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>